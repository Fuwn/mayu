require "./spec_helper"

describe "Mayu::CounterDatabase on PostgreSQL" do
  database_url = ENV["MAYU_TEST_DATABASE_URL"]?

  it "migrates, widens integers, and increments" do
    pending!("MAYU_TEST_DATABASE_URL is unset") unless database_url

    DB.connect(database_url) do |connection|
      connection.transaction do |transaction|
        database = Mayu::PostgresCounterDatabase.new(connection)

        connection.exec "create schema mayu_integration_test"
        connection.exec "set local search_path to mayu_integration_test"
        connection.exec <<-SQL
          create table tb_count (
            id integer generated by default as identity primary key,
            name text not null unique,
            num int not null default 0
          )
          SQL
        connection.exec "insert into tb_count (name, num) values ('legacy', 41)"
        connection.exec "select setval(pg_get_serial_sequence('tb_count', 'id'), 2147483647)"
        database.create_or_migrate_table
        database.create_or_migrate_table

        counter = database.increment("legacy")
        next_counter = database.increment("legacy")

        counter.count.should eq(42)
        counter.created_at.should be_nil
        counter.updated_at.should_not be_nil
        next_counter.count.should eq(43)
        connection.exec "update tb_count set num = 2147483647 where name = 'legacy'"

        large_counter = database.increment("legacy")
        column_types = connection.query_all(<<-SQL, as: {String, String})
          select attname::text, atttypid::regtype::text from pg_attribute
          where attrelid = 'tb_count'::regclass and attname in ('id', 'num')
          order by attname
          SQL
        sequence_maximum = connection.scalar(<<-SQL)
          select seqmax from pg_sequence
          where seqrelid = pg_get_serial_sequence('tb_count', 'id')::regclass
          SQL

        large_counter.count.should eq(2_147_483_648)
        column_types.should eq([{"id", "bigint"}, {"num", "bigint"}])
        sequence_maximum.should eq(Int64::MAX)
        transaction.rollback
      end
    end
  end
end
