require "log"
require "pg"
require "./counter_database"

module Mayu
  class PostgresCounterDatabase < CounterDatabase
    POOL_SIZE           = 25
    VERIFYING_SSL_MODES = {"verify-ca", "verify-full"}
    LOOPBACK_HOSTNAMES  = {"localhost", "127.0.0.1", "::1"}
    SQLITE_DATETIME_NOW = "to_char(now() at time zone 'utc', 'YYYY-MM-DD HH24:MI:SS')"

    INCREMENT_STATEMENT = <<-SQL
      insert into tb_count (name, created_at, updated_at, num)
      values ($1, #{SQLITE_DATETIME_NOW}, #{SQLITE_DATETIME_NOW}, 1)
      on conflict (name) do update set
        num = tb_count.num + 1,
        updated_at = #{SQLITE_DATETIME_NOW}
      returning name, num, created_at, updated_at;
      SQL

    def initialize(connection : DB::Database | DB::Connection)
      super(connection, INCREMENT_STATEMENT)
    end

    def self.open(url : String) : PostgresCounterDatabase
      uri = URI.parse(url)

      unless uri.scheme.in?("postgres", "postgresql")
        abort "Invalid MAYU_DATABASE_URL: expected a postgres:// URL"
      end

      if skips_certificate_verification?(uri)
        Log.warn { "MAYU_DATABASE_URL reaches #{uri.hostname} without sslmode=verify-full or verify-ca, so its certificate is not checked" }
      end

      uri.query_params = uri.query_params.tap do |parameters|
        parameters["max_pool_size"] = POOL_SIZE.to_s
        parameters["max_idle_pool_size"] = POOL_SIZE.to_s
      end

      new(DB.open(uri))
    end

    def self.skips_certificate_verification?(uri : URI) : Bool
      hostname = uri.hostname
      remote_host = !(hostname.nil? || hostname.empty? || hostname.in?(LOOPBACK_HOSTNAMES))
      verifies_certificate = uri.query_params["sslmode"]?.in?(VERIFYING_SSL_MODES)

      remote_host && !verifies_certificate
    end

    def create_or_migrate_table : Nil
      @connection.exec <<-SQL
        create table if not exists tb_count (
          id bigint generated by default as identity primary key,
          name text not null unique,
          num bigint not null default 0
        );
        SQL
      @connection.exec "alter table tb_count add column if not exists created_at text;"
      @connection.exec "alter table tb_count add column if not exists updated_at text;"

      integer_column_names = @connection.query_all(<<-SQL, as: String)
        select attname::text from pg_attribute
        where attrelid = 'tb_count'::regclass
          and attname in ('id', 'num')
          and atttypid = 'integer'::regtype
        SQL

      unless integer_column_names.empty?
        alterations = integer_column_names.join(", ") do |column_name|
          "alter column #{column_name} type bigint"
        end

        @connection.exec "alter table tb_count #{alterations}"
      end
    end
  end
end
