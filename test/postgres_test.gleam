import database
import envoy
import gleam/dynamic/decode
import gleam/erlang/process
import gleeunit/should
import pog

pub fn main() {
  let assert Ok(database_url) = envoy.get("MAYU_TEST_DATABASE_URL")
  let assert Ok(configuration) =
    pog.url_config(process.new_name("mayu_postgres_test"), database_url)
  let assert Ok(pool) = pog.start(configuration)
  let assert Error(pog.TransactionRolledBack(Nil)) =
    pog.transaction(pool.data, fn(connection) {
      execute(connection, "create schema mayu_integration_test")
      execute(connection, "set local search_path to mayu_integration_test")
      execute(
        connection,
        "create table tb_count (id integer generated by default as identity primary key, name text not null unique, num int not null default 0)",
      )
      execute(
        connection,
        "insert into tb_count (name, num) values ('legacy', 41)",
      )
      database.setup(database.Postgres(connection))
      database.setup(database.Postgres(connection))

      let assert Ok(counter) =
        database.get_counter(database.Postgres(connection), "legacy")
      let assert Ok(next_counter) =
        database.get_counter(database.Postgres(connection), "legacy")

      counter.num |> should.equal(42)
      counter.created_at |> should.equal("")
      counter.updated_at |> should.not_equal("")
      next_counter.num |> should.equal(43)
      execute(
        connection,
        "insert into tb_count (name, num, updated_at) values ('idle_low', 1, '2000-01-01 00:00:00'), ('idle_high', 9999, '2000-01-01 00:00:00'), ('legacy_null', 1, null)",
      )
      database.prune(database.Postgres(connection), 10, 30)

      let assert Ok(pog.Returned(_, rows)) =
        pog.query("select name from tb_count order by name")
        |> pog.returning(decode.at([0], decode.string))
        |> pog.execute(connection)

      rows |> should.equal(["idle_high", "legacy", "legacy_null"])

      Error(Nil)
    })

  Nil
}

fn execute(connection, statement) {
  let assert Ok(_) = pog.query(statement) |> pog.execute(connection)

  Nil
}
